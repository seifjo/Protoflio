# Copy to .env for local development
# For Vercel: add these same variables in Project → Settings → Environment Variables

# REQUIRED — Neon PostgreSQL (https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# REQUIRED — random secret for admin sessions
AUTH_SECRET="generate-a-long-random-string"

# REQUIRED — admin login credentials
ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Seif Kamel"

# REQUIRED on Vercel — your live site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# OPTIONAL — auto-set when you add Vercel Blob storage
# BLOB_READ_WRITE_TOKEN=""
