generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id                String  @id @default(cuid())
  title             String
  slug              String  @unique
  shortDescription  String  @default("")
  fullDescription   String  @default("")
  category          String  @default("")
  status            String  @default("draft")
  date              DateTime?
  role              String  @default("")
  featured          Boolean @default(false)
  published         Boolean @default(false)
  sortOrder         Int     @default(0)

  overview                String @default("")
  problem                 String @default("")
  solution                String @default("")
  challenges              String @default("")
  technicalImplementation String @default("")
  results                 String @default("")
  futureImprovements      String @default("")

  isPrivate  Boolean @default(false)
  showQrCode Boolean @default(false)
  qrMode     String  @default("apk")
  qrCustomUrl String @default("")

  seoTitle       String @default("")
  seoDescription String @default("")
  ogTitle        String @default("")
  ogDescription  String @default("")
  ogImage        String @default("")
  canonicalUrl   String @default("")

  technologies ProjectTechnology[]
  features     ProjectFeature[]
  images       ProjectImage[]
  links        ProjectLink[]
  videos       ProjectVideo[]
  files        ProjectFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([featured])
}

model ProjectTechnology {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)

  @@index([projectId, sortOrder])
}

model ProjectFeature {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String  @default("")
  sortOrder   Int     @default(0)

  @@index([projectId, sortOrder])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String  @default("")
  altText   String  @default("")
  isCover   Boolean @default(false)
  sortOrder Int     @default(0)
  width     Int?
  height    Int?

  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

model ProjectLink {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String
  label     String  @default("")
  url       String
  sortOrder Int     @default(0)

  @@index([projectId])
}

model ProjectVideo {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  title     String  @default("")
  sortOrder Int     @default(0)

  @@index([projectId])
}

model ProjectFile {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String
  fileUrl     String    @default("")
  externalUrl String    @default("")
  fileName    String    @default("")
  version     String    @default("")
  fileSize    String    @default("")
  releaseDate DateTime?

  createdAt DateTime @default(now())

  @@index([projectId, kind])
}

model SiteSettings {
  id              String @id @default("default")
  name            String @default("Seif Kamel")
  jobTitle        String @default("Flutter Developer")
  bio             String @default("")
  availability    String @default("Available for work")
  available       Boolean @default(true)
  email           String @default("")
  heroLabel       String @default("flutter build • live")
  heroName        String @default("SEIF KAMEL")
  heroRole        String @default("FLUTTER DEVELOPER")
  heroSubtitle    String @default("MOBILE & CROSS-PLATFORM DEVELOPER")
  heroMeta        String @default("FREELANCE • REMOTE • HYBRID")
  aboutText       String @default("")
  footerText      String @default("")
  profileImage    String @default("")
  favicon         String @default("")
  seoTitle        String @default("")
  seoDescription  String @default("")
  ogImage         String @default("")
  updatedAt       DateTime @updatedAt
}

model Skill {
  id          String @id @default(cuid())
  name        String
  category    String
  icon        String @default("")
  proficiency String @default("label")
  displayType String @default("label")
  sortOrder   Int    @default(0)
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String
  url       String
  label     String  @default("")
  sortOrder Int     @default(0)
  visible   Boolean @default(true)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
